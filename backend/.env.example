# ─── Server ───
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Database (Supabase PostgreSQL) ───
# DATABASE_URL: connection pooler (pgbouncer) — dùng cho app
# DIRECT_URL: direct connection — dùng cho prisma migrate
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ─── JWT ───
JWT_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Token TTL & policy ───
PASSWORD_COOLDOWN_DAYS=1
RESET_TOKEN_TTL_MIN=30
VERIFY_TOKEN_TTL_HOURS=24

# ─── VNPay Sandbox ───
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/api/payments/vnpay-return
VNP_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# ─── Supabase Storage ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Email (Gmail SMTP) ───
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=BusGo <your_email@gmail.com>

# ─── Anthropic Claude (Chatbot) ───
ANTHROPIC_API_KEY=your_anthropic_api_key
